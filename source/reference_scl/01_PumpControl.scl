// POMPA AIR - educational/offline template; not a safety PLC program.
// Target: TIA Portal V16, S7-1200 CPU 1214C DC/DC/DC.
// Inputs named *OK must be TRUE for healthy conditions; broken wires should read FALSE.
// LowWet/HighWet = TRUE when water reaches the respective tank sensor.
FUNCTION_BLOCK "FB_PumpControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
   VAR_INPUT
      FirstScan : Bool;
      AutoMode : Bool;
      StartButton : Bool;
      StopOK : Bool;
      SafetyOK : Bool;
      OverloadOK : Bool;
      SourceWaterOK : Bool;
      LowWet : Bool;
      HighWet : Bool;
      ResetButton : Bool;
      MotorFeedback : Bool;
      MinOffTime : Time := T#5s;
      FeedbackTime : Time := T#3s;
      MaxRunTime : Time := T#10m;
   END_VAR
   VAR_OUTPUT
      PumpCmd : Bool;
      Alarm : Bool;
      Enabled : Bool;
      RunningConfirmed : Bool;
      FaultBits : Word;
      State : USInt;
   END_VAR
   VAR
      RunState : Bool := FALSE;
      EnableState : Bool := FALSE;
      FaultMemory : Word := W#16#0000;
      StartPrev : Bool;
      ResetPrev : Bool;
      AutoPrev : Bool;
      AutoDemand : Bool;
      ManualDemand : Bool;
      OffTimer : TON_TIME;
      RunTimer : TON_TIME;
      StartFeedbackTimer : TON_TIME;
      StopFeedbackTimer : TON_TIME;
   END_VAR
   VAR_TEMP
      StartPulse : Bool;
      ResetPulse : Bool;
      ModeChanged : Bool;
      SensorInvalid : Bool;
      ConfigInvalid : Bool;
      HealthyInputs : Bool;
      Demand : Bool;
   END_VAR
BEGIN
   // FirstScan MUST come from OB1 Initial_Call. All instance data is non-retentive.
   IF #FirstScan THEN
      #EnableState := FALSE;
      #RunState := FALSE;
      #AutoDemand := FALSE;
      #ManualDemand := FALSE;
      #FaultMemory := W#16#0000;
      #StartPrev := #StartButton;
      #ResetPrev := #ResetButton;
      #AutoPrev := #AutoMode;
   END_IF;

   #StartPulse := #StartButton AND NOT #StartPrev AND NOT #FirstScan;
   #ResetPulse := #ResetButton AND NOT #ResetPrev AND NOT #FirstScan;
   #ModeChanged := #AutoMode <> #AutoPrev;
   #SensorInvalid := #HighWet AND NOT #LowWet;
   #ConfigInvalid := (#MinOffTime <= T#0ms) OR (#FeedbackTime <= T#0ms) OR (#MaxRunTime <= T#0ms);
   #HealthyInputs := #SafetyOK AND #OverloadOK AND #SourceWaterOK AND NOT #SensorInvalid AND NOT #ConfigInvalid;

   // Timers observe the preceding scan's command. Faults cancel this scan's output.
   #OffTimer(IN := NOT #RunState AND NOT #FirstScan, PT := #MinOffTime);
   #RunTimer(IN := #RunState AND NOT #FirstScan, PT := #MaxRunTime);
   #StartFeedbackTimer(IN := #RunState AND NOT #MotorFeedback AND NOT #FirstScan, PT := #FeedbackTime);
   #StopFeedbackTimer(IN := NOT #RunState AND #MotorFeedback AND NOT #FirstScan, PT := #FeedbackTime);

   // A reset clears the latch only when healthy, stopped, and feedback is OFF.
   // Reset never enables or starts the pump. Start must be released and pressed again.
   IF #ResetPulse AND #HealthyInputs AND NOT #RunState AND NOT #MotorFeedback THEN
      #FaultMemory := W#16#0000;
   END_IF;
   IF NOT #SafetyOK THEN
      #FaultMemory := #FaultMemory OR W#16#0001;
   END_IF;
   IF NOT #OverloadOK THEN
      #FaultMemory := #FaultMemory OR W#16#0002;
   END_IF;
   IF NOT #SourceWaterOK THEN
      #FaultMemory := #FaultMemory OR W#16#0004;
   END_IF;
   IF #SensorInvalid THEN
      #FaultMemory := #FaultMemory OR W#16#0008;
   END_IF;
   IF #RunTimer.Q THEN
      #FaultMemory := #FaultMemory OR W#16#0010;
   END_IF;
   IF #StartFeedbackTimer.Q THEN
      #FaultMemory := #FaultMemory OR W#16#0020;
   END_IF;
   IF #StopFeedbackTimer.Q THEN
      #FaultMemory := #FaultMemory OR W#16#0040;
   END_IF;
   IF #ConfigInvalid THEN
      #FaultMemory := #FaultMemory OR W#16#0080;
   END_IF;
   #Alarm := #FaultMemory <> W#16#0000;

   // STOP, reset, mode change, restart and faults all require a NEW Start edge.
   IF #FirstScan OR NOT #StopOK OR #Alarm OR #ModeChanged OR #ResetButton THEN
      #EnableState := FALSE;
      #AutoDemand := FALSE;
      #ManualDemand := FALSE;
   ELSIF #StartPulse AND #HealthyInputs AND NOT #MotorFeedback THEN
      #EnableState := TRUE;
      IF NOT #AutoMode THEN
         #ManualDemand := NOT #HighWet;
      END_IF;
   END_IF;

   IF #EnableState AND #AutoMode THEN
      IF #HighWet THEN
         #AutoDemand := FALSE;
      ELSIF NOT #LowWet THEN
         #AutoDemand := TRUE;
      END_IF;
      #ManualDemand := FALSE;
   ELSE
      #AutoDemand := FALSE;
   END_IF;

   IF #HighWet THEN
      #ManualDemand := FALSE;
      IF NOT #AutoMode THEN
         #EnableState := FALSE;
      END_IF;
   END_IF;

   #Demand := (#AutoMode AND #AutoDemand) OR (NOT #AutoMode AND #ManualDemand);
   #RunState := #EnableState AND #Demand AND #HealthyInputs AND #StopOK AND NOT #Alarm AND NOT #HighWet AND NOT #FirstScan AND (#RunState OR #OffTimer.Q);
   #RunningConfirmed := #RunState AND #MotorFeedback;

   // State: 0 stopped, 10 auto standby, 20 waiting min-off, 30 starting, 40 running, 90 fault.
   IF #Alarm THEN
      #State := 90;
   ELSIF NOT #EnableState THEN
      #State := 0;
   ELSIF #RunState AND #MotorFeedback THEN
      #State := 40;
   ELSIF #RunState THEN
      #State := 30;
   ELSIF #Demand THEN
      #State := 20;
   ELSE
      #State := 10;
   END_IF;

   // Output parameters are written every scan; persistent state lives in STAT.
   #PumpCmd := #RunState;
   #Enabled := #EnableState;
   #FaultBits := #FaultMemory;

   #StartPrev := #StartButton;
   #ResetPrev := #ResetButton;
   #AutoPrev := #AutoMode;
END_FUNCTION_BLOCK

DATA_BLOCK "DB_PumpControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
NON_RETAIN
"FB_PumpControl"
BEGIN
END_DATA_BLOCK
